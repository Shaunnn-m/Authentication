{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "AuthenticationDatabase": ""
  },
  "Jwt": {
    "Issuer": "AuthenticationService",
    "Audience": "AuthenticationClients",
    "SigningKey": "",
    "AccessTokenExpirationMinutes": 15
  },
  "Authentication": {
    "ConfirmationBaseUrl": "http://localhost:5175/api/authentication/confirm-email",
    "PasswordResetBaseUrl": "http://localhost:5175/api/authentication/reset-password",
    "EmailChangeBaseUrl": "http://localhost:5175/api/account/confirm-email-change",
     "Email": {
      "Enabled": true,
      "Mode": "AuthenticationService"
    },
    "InitialAdmin": {
      "Email": "admin@example.com",
      "Password": "AdminPassword123!",
      "FirstName": "System",
      "LastName": "Administrator"
    }
  },
  "AllowedHosts": "*"
}
