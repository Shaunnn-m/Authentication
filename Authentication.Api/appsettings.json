{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "AuthenticationDatabase": ""
  },
  "Jwt": {
    "Issuer": "AuthenticationService",
    "Audience": "AuthenticationClients",
    "SigningKey": "THIS_IS_ONLY_FOR_LOCAL_DEVELOPMENT_CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY",
    "AccessTokenExpirationMinutes": 15
  },
  "Authentication": {
    "ConfirmationBaseUrl": "http://localhost:4200/confirm-email",
     "EmailConfirmation": {
      "Enabled": true,
      "Mode": "AuthenticationService"
    }
  },
  
  "AllowedHosts": "*"
}
